{
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "format_on_save": "on",
      "formatter": "rust-analyzer",
      "hard_tabs": false,
      "tab_size": 4,
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "cargo",
          "args": ["check", "--all-targets", "--all-features"],
        },
        "cargo": {
          "buildScripts": {
            "enable": true,
          },
          "features": "all",
        },
        "procMacro": {
          "enable": true,
        },
        "diagnostics": {
          "enable": true,
          "experimental": {
            "enable": true,
          },
        },
        "inlayHints": {
          "enable": true,
          "typeHints": {
            "enable": true,
          },
          "parameterHints": {
            "enable": true,
          },
          "chainingHints": {
            "enable": true,
          },
        },
      },
    },
  },
  "terminal": {
    "env": {
      "RUST_LOG": "debug",
      "RUST_BACKTRACE": "1",
    },
  },

  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
}
