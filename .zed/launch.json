{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug jimjam",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/jimjam",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "debug",
        "RUST_BACKTRACE": "1",
      },
      "sourceLanguages": ["rust"],
      "preLaunchTask": {
        "type": "shell",
        "command": "cargo",
        "args": ["build"],
      },
    },
    {
      "name": "Debug jimjam (verbose)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/jimjam",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "trace",
        "RUST_BACKTRACE": "full",
      },
      "sourceLanguages": ["rust"],
      "preLaunchTask": {
        "type": "shell",
        "command": "cargo",
        "args": ["build"],
      },
    },
  ],
}
